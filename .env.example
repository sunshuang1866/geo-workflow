# platform-chat: Web UI automation credentials (DeepSeek / Qwen auto-login)
# ChatGPT and Gemini use session files; see output/{community}/.chatgpt-session.json / .gemini-session.json
DEEPSEEK_WEB_EMAIL=
DEEPSEEK_WEB_PASSWORD=
QWEN_WEB_EMAIL=
QWEN_WEB_PASSWORD=

# Issue Creation
GITCODE_TOKEN=
GITHUB_TOKEN=

# Workflow Config — set once per community, all skills read from here
GEO_COMMUNITY=MindSpore
GEO_COMMUNITY_DIR=output/MindSpore/
GEO_FORUM_URL=https://discuss.mindspore.cn
GEO_PATHS=all
GEO_DRY_RUN=false
GEO_REPO_URL=https://github.com/opensourceways/geo-workflow
GEO_QUESTION_TARGET_COUNT=100

# get-question: Issue path (datastat API)
DATASTAT_EMAIL=
DATASTAT_PASSWORD=

# get-question: Website search path (optional)
WEBSITE_SEARCH_URL=
WEBSITE_SEARCH_TOKEN=

# classify-scenarios: Community documentation index URL (HTML directory tree / sitemap.xml / JSON)
# Used to automatically derive the application scenario taxonomy for question classification.
# Examples:
#   openEuler:  https://docs.openeuler.org/zh/docs/
#   MindSpore:  https://www.mindspore.cn/docs/zh-CN/
#   openUBMC:   https://docs.openubmc.org/sitemap.xml
DOCS_INDEX_URL=

# get-question: MongoDB community-hot-topic (primary data source, all communities)
MONGODB_HOST=
MONGODB_PORT=8635
MONGODB_USER=
MONGODB_PASSWORD=

# get-question: PostgreSQL hotopic DB (fallback when MongoDB unavailable)
# Option A (single community):
HOTOPIC_DB_HOST=
HOTOPIC_DB_PORT=5432
HOTOPIC_DB_NAME=
HOTOPIC_DB_USER=
HOTOPIC_DB_PASSWORD=

# Option B (multi-community JSON; takes precedence over Option A)
# Example:
# HOTOPIC_DB_CONFIG_JSON={"openeuler":{"host":"...","port":"5432","dbname":"...","user":"...","password":"..."},"mindspore":{"host":"...","port":"5432","dbname":"...","user":"...","password":"..."}}
HOTOPIC_DB_CONFIG_JSON=